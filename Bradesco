<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bradesco</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        
        body {
            background: #f5f5f5;
            color: #333;
            line-height: 1.5;
            min-height: 100vh;
        }
        
        .container {
            max-width: 100%;
            background: white;
            min-height: 100vh;
            position: relative;
        }
        
        /* Header Minimalista */
        .app-header {
            background: #CC092F;
            color: white;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        
        .app-name {
            font-weight: bold;
            font-size: 20px;
        }
        
        .header-icons {
            display: flex;
            gap: 15px;
        }
        
        .header-icons i {
            font-size: 18px;
        }
        
        /* Account Info */
        .account-info {
            background: #CC092F;
            color: white;
            padding: 20px;
            position: relative;
        }
        
        .user-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        
        .user-name {
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            padding: 5px;
            border-radius: 4px;
            transition: background-color 0.2s;
        }
        
        .user-name:hover {
            background-color: rgba(255,255,255,0.1);
        }
        
        .notification {
            position: relative;
        }
        
        .notification-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #FFD700;
            color: #CC092F;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            font-size: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }
        
        .balance-info {
            text-align: center;
            margin-bottom: 10px;
        }
        
        .balance-label {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 5px;
        }
        
        .balance-value {
            font-size: 26px;
            font-weight: 700;
            cursor: pointer;
            padding: 5px;
            border-radius: 4px;
            transition: background-color 0.2s;
        }
        
        .balance-value:hover {
            background-color: rgba(255,255,255,0.1);
        }
        
        .account-vat {
            font-size: 12px;
            opacity: 0.7;
            text-align: center;
        }
        
        /* Menu Principal Compacto */
        .main-menu {
            display: flex;
            justify-content: space-around;
            padding: 15px 0;
            background-color: white;
            border-bottom: 1px solid #e0e0e0;
        }
        
        .menu-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
        }
        
        .menu-icon {
            width: 45px;
            height: 45px;
            background-color: #f8f8f8;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 5px;
            color: #CC092F;
            font-size: 18px;
            transition: all 0.3s;
        }
        
        .menu-item:active .menu-icon {
            background-color: #CC092F;
            color: white;
            transform: scale(0.95);
        }
        
        .menu-name {
            font-size: 12px;
            color: #333;
            font-weight: 500;
        }
        
        /* Search Bar Compacta */
        .search-container {
            background-color: white;
            border-radius: 20px;
            padding: 12px 15px;
            margin: 15px;
            box-shadow: 0 1px 5px rgba(0,0,0,0.05);
            display: flex;
            align-items: center;
            border: 1px solid #e0e0e0;
        }
        
        .search-icon {
            color: #CC092F;
            margin-right: 10px;
            font-size: 16px;
        }
        
        .search-input {
            border: none;
            outline: none;
            width: 100%;
            font-size: 14px;
            color: #666;
            background: transparent;
        }
        
        /* Section Titles Compactos */
        .section-title {
            font-size: 16px;
            font-weight: 600;
            margin: 20px 15px 10px;
            color: #333;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .see-all {
            font-size: 14px;
            color: #CC092F;
            font-weight: normal;
            text-decoration: none;
        }
        
        /* Favorites Grid Compacto */
        .favorites-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            padding: 0 15px;
            margin-bottom: 20px;
        }
        
        .favorite-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        
        .favorite-icon {
            width: 45px;
            height: 45px;
            background-color: #f8f8f8;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 8px;
            color: #CC092F;
            font-size: 18px;
            border: 1px solid #eaeaea;
            transition: all 0.3s;
        }
        
        .favorite-item:active .favorite-icon {
            background-color: #CC092F;
            color: white;
            transform: scale(0.95);
        }
        
        .favorite-name {
            font-size: 12px;
            color: #333;
        }
        
        /* Promo Banner Compacto */
        .promo-banner {
            background: linear-gradient(135deg, #CC092F, #a50626);
            border-radius: 12px;
            padding: 15px;
            margin: 0 15px 20px;
            display: flex;
            align-items: center;
            color: white;
        }
        
        .promo-icon {
            width: 40px;
            height: 40px;
            background-color: rgba(255,255,255,0.2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            font-size: 18px;
        }
        
        .promo-content h3 {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 3px;
        }
        
        .promo-content p {
            font-size: 12px;
            opacity: 0.9;
        }
        
        /* Divider */
        .divider {
            height: 6px;
            background-color: #f0f0f0;
            margin: 20px 0;
        }
        
        /* Benefits Section Compacto */
        .benefits-section {
            padding: 0 15px 25px;
        }
        
        .benefits-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }
        
        .benefit-item {
            background-color: #f9f9f9;
            border-radius: 12px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            border: 1px solid #eaeaea;
            transition: all 0.3s;
            cursor: pointer;
        }
        
        .benefit-item:active {
            transform: scale(0.98);
            background-color: #f0f0f0;
        }
        
        .benefit-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #CC092F, #a50626);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
            color: white;
            font-size: 18px;
        }
        
        .benefit-name {
            font-size: 13px;
            font-weight: 500;
            color: #333;
        }
        
        .benefit-description {
            font-size: 11px;
            color: #666;
            margin-top: 3px;
        }
        
        /* Bottom Navigation Compacta */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background-color: white;
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            border-top: 1px solid #e0e0e0;
            z-index: 100;
        }
        
        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #666;
            font-size: 12px;
            transition: color 0.3s;
            cursor: pointer;
        }
        
        .nav-item.active {
            color: #CC092F;
        }
        
        .nav-item:active {
            color: #CC092F;
        }
        
        .nav-icon {
            font-size: 20px;
            margin-bottom: 3px;
        }
        
        /* BIA Assistant */
        .bia-assistant {
            position: fixed;
            bottom: 60px;
            right: 15px;
            width: 50px;
            height: 50px;
            background: #CC092F;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            box-shadow: 0 3px 10px rgba(204, 9, 47, 0.3);
            z-index: 100;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .bia-assistant:active {
            transform: scale(0.95);
        }
        
        /* Face ID Screen */
        .faceid-screen {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #1a1a1a;
            z-index: 2000;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px;
            color: white;
        }
        
        .faceid-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
        }
        
        .faceid-icon {
            width: 120px;
            height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 30px;
            position: relative;
        }
        
        .faceid-animation {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: linear-gradient(45deg, #4CAF50, #2196F3);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            box-shadow: 0 0 30px rgba(76, 175, 80, 0.5);
        }
        
        .faceid-animation::before {
            content: '';
            position: absolute;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: #1a1a1a;
        }
        
        .faceid-animation::after {
            content: '';
            position: absolute;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(45deg, #4CAF50, #2196F3);
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0% { transform: scale(0.8); opacity: 0.7; }
            50% { transform: scale(1.2); opacity: 1; }
            100% { transform: scale(0.8); opacity: 0.7; }
        }
        
        .faceid-text {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 15px;
            color: white;
        }
        
        .faceid-subtext {
            font-size: 16px;
            color: rgba(255,255,255,0.8);
            margin-bottom: 40px;
            line-height: 1.5;
        }
        
        .faceid-progress {
            width: 200px;
            height: 4px;
            background-color: rgba(255,255,255,0.2);
            border-radius: 2px;
            overflow: hidden;
            margin-bottom: 25px;
        }
        
        .faceid-progress-bar {
            height: 100%;
            background: #4CAF50;
            width: 0%;
            border-radius: 2px;
            animation: progressFill 2s ease-in-out forwards;
        }
        
        @keyframes progressFill {
            0% {
                width: 0%;
            }
            100% {
                width: 100%;
            }
        }
        
        .confirmation-text {
            font-size: 18px;
            font-weight: 600;
            color: #4CAF50;
            margin-top: 20px;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2s forwards;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .confirmation-text i {
            font-size: 20px;
        }
        
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        /* Edit Modal */
        .edit-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.5);
            z-index: 3000;
            justify-content: center;
            align-items: center;
        }
        
        .edit-modal-content {
            background-color: white;
            padding: 20px;
            border-radius: 12px;
            width: 85%;
            max-width: 350px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
        }
        
        .edit-modal-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
            text-align: center;
            color: #333;
        }
        
        .edit-input {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 16px;
            margin-bottom: 15px;
        }
        
        .edit-input:focus {
            border-color: #CC092F;
            outline: none;
        }
        
        .edit-buttons {
            display: flex;
            justify-content: space-between;
        }
        
        .edit-button {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .edit-cancel {
            background-color: #f0f0f0;
            color: #333;
        }
        
        .edit-save {
            background-color: #CC092F;
            color: white;
        }
        
        .edit-button:active {
            transform: scale(0.95);
        }
        
        /* Safe Area for Notch */
        .safe-area {
            padding-top: env(safe-area-inset-top);
            padding-bottom: env(safe-area-inset-bottom);
        }
    </style>
</head>
