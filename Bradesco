    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Elementos da tela
            const faceIdScreen = document.getElementById('faceid-screen');
            const appScreen = document.getElementById('app-screen');
            
            // Elementos para edição
            const editableName = document.getElementById('editable-name');
            const editableBalance = document.getElementById('editable-balance');
            const editModal = document.getElementById('edit-modal');
            const editModalTitle = document.getElementById('edit-modal-title');
            const editInput = document.getElementById('edit-input');
            const editCancel = document.getElementById('edit-cancel');
            const editSave = document.getElementById('edit-save');
            
            let currentEditingElement = null;
            
            // Inicialmente mostrar apenas o Face ID
            faceIdScreen.style.display = 'flex';
            appScreen.style.display = 'none';
            editModal.style.display = 'none';
            
            // Simular processo de Face ID
            setTimeout(function() {
                // Mostrar confirmação
                document.querySelector('.confirmation-text').style.display = 'flex';
                
                // Acesso automático à conta após confirmação
                setTimeout(function() {
                    faceIdScreen.style.display = 'none';
                    appScreen.style.display = 'block';
                }, 1500);
            }, 2500);
            
            // Função para editar o nome
            editableName.addEventListener('click', function() {
                currentEditingElement = editableName;
                editModalTitle.textContent = 'Editar Nome';
                editInput.value = editableName.textContent;
                editModal.style.display = 'flex';
            });
            
            // Função para editar o saldo
            editableBalance.addEventListener('click', function() {
                currentEditingElement = editableBalance;
                editModalTitle.textContent = 'Editar Saldo';
                editInput.value = editableBalance.textContent;
                editModal.style.display = 'flex';
            });
            
            // Cancelar edição
            editCancel.addEventListener('click', function() {
                editModal.style.display = 'none';
                currentEditingElement = null;
            });
            
            // Salvar edição
            editSave.addEventListener('click', function() {
                if (currentEditingElement && editInput.value.trim() !== '') {
                    currentEditingElement.textContent = editInput.value;
                    editModal.style.display = 'none';
                    currentEditingElement = null;
                }
            });
            
            // Fechar modal ao clicar fora dele
            editModal.addEventListener('click', function(e) {
                if (e.target === editModal) {
                    editModal.style.display = 'none';
                    currentEditingElement = null;
                }
            });

            // Interações da conta
            document.querySelector('.bia-assistant').addEventListener('click', function() {
                alert('Olá! Sou o BIA, seu assistente virtual. Como posso ajudar?');
            });
        });
    </script>
</body>
</html>